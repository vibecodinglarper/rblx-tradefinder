{
  "name": "rblx-tradefinder",
  "version": "1.0.0",
  "private": true,
  "description": "Discord trade recommendations using Rolimons values and public Roblox inventories",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "register": "node --env-file-if-exists=.env --import tsx src/register.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "smoke": "node --import tsx scripts/smoke.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "screenshots": "node --import tsx scripts/screenshots.ts && python3 scripts/screenshot.py"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.27.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
