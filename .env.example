# Reset the exposed token and put the NEW token here. Never commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in one server for immediate testing.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/tradefinder.sqlite
# Required for /connect and Place Trade. Keep separate from the database and retain across restarts.
# Generate once with: openssl rand -hex 32
ROBLOX_CREDENTIAL_KEY=
# How often the alert monitor scans. Every scan reads seller inventories, so shorter is not always better.
POLL_INTERVAL_SECONDS=60
# Sellers verified per search. This is the slowest part of a search: Roblox is called once per seller.
MAX_SELLERS_PER_SEARCH=30
# The rolling trade-ad archive. Ads past the window are deleted, and the newest always displace the oldest
# once the row cap is reached, so both the database and the time a search takes stay bounded.
AD_ARCHIVE_HOURS=24
AD_ARCHIVE_MAX_ADS=100000
# HTTP port for the /health readiness endpoint a hosting platform polls. 0 leaves it switched off.
HEALTH_PORT=0
